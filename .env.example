# Copy to .env and fill in what you need. Every setting has a working default; with none of these set, Vaani runs
# fully offline: local Whisper speech recognition (after `python scripts/download_models.py`), the browser's voice
# for the examiner, and the rule-based scorer.

# --- deployment
APP_ENV=development
BASE_URL=http://localhost:8000
# DATA_DIR=./data
# DATABASE_URL=postgresql://vaani:vaani@localhost:5432/vaani    # default: SQLite in DATA_DIR
# SECRET_KEY=...                   # generated and kept in DATA_DIR if empty
# DATA_ENCRYPTION_KEY=...          # Fernet key for recordings; generated and kept in DATA_DIR if empty. Back it up!
TRUST_PROXY=false
# WEB_WORKERS=1                   # web processes (Docker); more processes = more concurrent vivas with hosted STT
ADMIN_EMAIL=admin@vaani.local
ADMIN_PASSWORD=admin12345          # change this
SEED_DEMO=true                     # demo faculty, two question banks, two open vivas, five recorded samples
RETENTION_DAYS=180
# CONSENT_CONTACT=dpo@yourcollege.edu

# --- speech-to-text: whisper-onnx | groq | openai | sarvam | faster-whisper | browser
# STT_ENGINE=                     # empty = automatic: whisper-onnx if the model is downloaded, else groq/openai/sarvam
                                   # if a key is set, else browser
WHISPER_MODEL=base.en              # tiny.en (fastest) | base.en (recommended) | small.en | base (multilingual, Hinglish)
# STT_CONCURRENCY=0                # recognition workers; 0 = one per CPU core
# --- examiner voice: browser | flite | piper | openai | sarvam
TTS_ENGINE=browser

# --- AI for scoring and live follow-up wording: mock | groq | openai | ollama
# LLM_PROVIDER=                   # empty = automatic: openai or groq when its key is set, otherwise mock (rule scorer)
# GROQ_API_KEY=
# OPENAI_API_KEY=
# SARVAM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
